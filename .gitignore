local.properties
# Machine-specific: hardcodes this box's JAVA_HOME so builds can be driven
# from WSL. Nothing in it is portable.
/gw.bat

# Downloaded from the Google Cloud console when the Android OAuth client was
# created. Neither is read by the build — the app sends the *web* client id,
# which lives in app/build.gradle.kts as a buildConfigField. The JSON holds no
# client_secret (an Android client is a public client), but a file with that
# name in a repository is a secret-scanner alert waiting to happen.
client_secret_*.json
clientid.txt
